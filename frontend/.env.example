# -----------------------------------------------------------------------
# APEX Frontend — Environment Variables
#
# Copy this file to .env before running the dev server locally.
# The hosted version at https://apexsimulator.org is already configured.
# These values are only needed for local development.
#
# Docker: the same VITE_* keys are set in the repo-root `.env` for
# `docker compose build` (build args). Changing VITE_* requires a rebuild,
# not just `docker compose up` — see docs/docker.md.
# -----------------------------------------------------------------------

# URL of the running backend API (change port if needed)
VITE_API_URL=http://localhost:8000

# Supabase project credentials (public anon key — still do not commit production-only overrides)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

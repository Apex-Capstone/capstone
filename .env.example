# =============================================================================
# APEX — root environment file for Docker Compose (copy to `.env` and fill in).
# =============================================================================
# Docker Compose reads this file from the repository root (`env_file: .env`).
# Settings use Pydantic `case_sensitive=False`; uppercase names below match
# conventional deployment variables. Do not commit real secrets.
#
# Service-specific examples also live at:
#   backend/.env.example
#   frontend/.env.example
# =============================================================================

# -----------------------------------------------------------------------------
# Backend — required (no sensible defaults in app settings)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-dashboard

OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# Backend — production / Docker recommended
# -----------------------------------------------------------------------------
# Browser origin(s) allowed to call the API with credentials (JSON array or comma-separated).
# Example for local SPA on port 8080: ["http://localhost:8080","http://127.0.0.1:8080"]
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

# Public URL of this API (used for assistant audio URLs like /v1/turns/{id}/audio).
# In Docker Compose default, the API is at http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Frontend — build-time (baked into the JS bundle when the image is built)
# -----------------------------------------------------------------------------
# Must be reachable from the user’s browser (not from inside the frontend container).
VITE_API_URL=http://localhost:8000

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# Backend — optional: storage / Supabase object storage / audio TTL
# -----------------------------------------------------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=your-bucket-name

# LOCAL_STORAGE_PATH=./storage
# AUDIO_CACHE_PATH=./storage/cache/audio
# AUDIO_CACHE_MAX_BYTES=536870912
# ASSISTANT_AUDIO_TTL_SECONDS=604800
# ASSISTANT_AUDIO_SIGNED_URL_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Backend — optional: migrations at container start
# -----------------------------------------------------------------------------
# Set to 0 when running multiple API replicas (run Alembic as a separate one-off job).
# RUN_MIGRATIONS=1

# -----------------------------------------------------------------------------
# Backend — optional: app / LLM / plugins (defaults exist in code)
# -----------------------------------------------------------------------------
# ENVIRONMENT=development
# LOG_LEVEL=INFO
# SECRET_KEY=change-me
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# DEFAULT_LLM_PROVIDER=openai
# OPENAI_MODEL_ID=gpt-4
# GEMINI_MODEL_ID=gemini-pro
# TTS_PROVIDER=openai
# ASR_PROVIDER=whisper
# RESEARCH_ANON_SALT=change-in-production
